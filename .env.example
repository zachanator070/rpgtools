# Example environment file, all supported options should be here
# commented out environment variables are optional,
# uncommented varirables are required to operate

# port that the rpgtools service will listen on, defaults to 3000
#SERVER_PORT=80

# required to use postgres, hostname of the postgres instance to use, this variable is required to use a postgres database
#POSTGRES_HOST=postgres
# username to use to connect to the postgres database, defaults to 'rpgtools'
#POSTGRES_USER=rpgtools
# password to use to connect to the postgres database, defaults to 'password'
#POSTGRES_PASSWORD=password
# name of the database to use on the postgres instance, defaults to 'rpgtools'
#POSTGRES_DB=rpgtools
#Whether or not to print sql logging to std out
#SQL_LOGGING=false

# required to use sqlite, directory path to sqlite database files, defaults to '/opt/rpgtools/db'
#SQLITE_DIRECTORY_PATH=/opt/rpgtools/db
# optional file name of the sqlite database to use, defaults to 'rpgtools'
#SQLITE_DB_NAME=rpgtools

# url to use if you want redis to cache requests
# see https://github.com/NodeRedis/node-redis#options-object-properties for the possible formats of this url
#REDIS_URL=redis://redis:6379

# Do not use these secrets, you can generate a 2048-bit sized keys with the following unix command:
# openssl rand -base64 256

# If these options are not specified, user sessions will end if the server is restarted

# private key used to sign access token cookies, if not specified it will be generated on start
ACCESS_TOKEN_SECRET="supersecret9000"

# private key used to sign access refresh cookies, if not specified it will be generated on start
REFRESH_TOKEN_SECRET="supersecret9000"

# private key used to sign short lived SSO state JWT values
SSO_STATE_SECRET="supersecret9000"

# Google OAuth credentials for SSO
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMTP email configuration used to send invite and other transactional emails
# SMTP host, for example smtp.gmail.com
# SMTP_HOST=
# SMTP port, usually 587 (STARTTLS) or 465 (SSL)
# SMTP_PORT=587
# whether SMTP should use TLS immediately (true for 465, false for 587)
# SMTP_SECURE=false
# SMTP username/login
# SMTP_USER=
# SMTP password/app-password
# SMTP_PASSWORD=
# sender email address used in outgoing emails
# SMTP_FROM_EMAIL=
# optional sender display name, defaults to RPG Tools
# SMTP_FROM_NAME=RPG Tools

# public base URL used in outbound emails (invite links, etc)
# RPGTOOLS_PUBLIC_URL=https://rpgtools.thezachcave.com
