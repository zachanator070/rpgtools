{
  "name": "@rpgtools/server",
  "version": "1.0.0",
  "author": "zachanator070",
  "description": "Tool set for playing an RPG game",
  "license": "MIT",
  "repository": "https://github.com/zachanator070/rpgtools",
  "type": "module",
  "scripts": {
    "start": "node dist/server/src/index.js",
    "predev:start": "npm run build",
    "dev:start": "node --inspect=0.0.0.0 --enable-source-maps dist/server/src/index.js",
    "dev:start-brk": "node --inspect-brk=0.0.0.0 --enable-source-maps dist/server/src/index.js",
    "build": "tsc",
    "dev": "nodemon --watch src -e ts,ejs --signal SIGTERM --exec npm run dev:start",
    "dev-brk": "nodemon --watch src -e ts,ejs --exec npm-run-all build dev:start-brk",
    "test:integration": "vitest run --config vitest.integration.config.ts --dir tests/integration ${VITEST_OPTIONS}",
    "test:unit": "vitest run --dir tests/unit"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express4": "^1.1.2",
    "@graphql-tools/schema": "^10.0.30",
    "@rpgtools/common": "*",
    "archiver": "^5.3.0",
    "ascii-table": "^0.0.9",
    "async-mutex": "^0.3.1",
    "axios": "^1.16.0",
    "bcrypt": "^5.0.1",
    "body-parser": "^1.20.3",
    "cls-hooked": "^4.2.2",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dataloader": "^2.0.0",
    "express": "^4.20.0",
    "graphql": "^16.12.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-upload": "^17.0.0",
    "graphql-ws": "^6.0.6",
    "gridfs-stream": "^1.1.1",
    "inversify": "^5.1.1",
    "jimp": "^0.16.1",
    "jsonwebtoken": "^9.0.0",
    "minimist": "^1.2.5",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.13",
    "nodemon": "^2.0.12",
    "npm-run-all": "^4.1.5",
    "pg": "^8.8.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.1.13",
    "remark-parse": "^11.0.0",
    "sequelize": "^6.29.0",
    "sqlite3": "^5.1.2",
    "umzug": "^3.2.1",
    "unified": "^10.1.0",
    "unist-util-visit": "^4.0.0",
    "unzipper": "^0.10.11",
    "uuid": "^8.3.2",
    "winston": "^3.19.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/archiver": "^5.1.1",
    "@types/bcrypt": "^5.0.0",
    "@types/bson": "^4.2.0",
    "@types/cls-hooked": "^4.3.8",
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/graphql-upload": "^17.0.0",
    "@types/jsonwebtoken": "^8.5.4",
    "@types/morgan": "^1.9.3",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.6.5",
    "@types/redis": "^4.0.11",
    "@types/type-is": "^1.6.3",
    "@types/unzipper": "^0.10.4",
    "@types/uuid": "^8.3.1",
    "@types/winston": "^2.4.4",
    "@types/ws": "^8.5.4",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^16.0.3",
    "eslint": "^8.23.0",
    "esm": "^3.2.25",
    "is-typedarray": "^1.0.0",
    "lodash": "^4.17.21",
    "request": "^2.88.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
