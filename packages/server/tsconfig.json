{
  "compilerOptions": {
    "allowJs": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["reflect-metadata", "vitest/globals"],
    "module": "node20",
    "esModuleInterop": true,
    "target": "ES2024",
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "sourceMap": true,
    "outDir": "./dist/server",
    "baseUrl": ".",
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "sourceMap": true
}